# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://kubo@127.0.0.1:5433/kubo
# Chave Fernet dos dados pessoais criptografados (CPF). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Número de proxies confiáveis à frente do Django (o rewrite do Next conta como 1).
NUM_PROXIES=1
# URL pública do app do cliente, usada nos links de e-mail.
CONSUMER_APP_URL=http://localhost:3000
# CEP de onde as peças saem, usado na cotação de frete.
INTERNAL_PARTNER_POSTAL_CODE=01001000
# Teto global de gasto diário com IA, em dólares.
DAILY_SPEND_CAP_USD=30

# --- Adapters: fornecedores reais. Preencha as chaves abaixo ---
IMAGE_GENERATION_ADAPTER=integrations.adapters.runware.RunwareImageGenerationAdapter
MODEL_3D_ADAPTER=integrations.adapters.runware.RunwareModel3DAdapter
PAYMENT_GATEWAY_ADAPTER=integrations.adapters.abacatepay.AbacatePayAdapter
SHIPPING_ADAPTER=integrations.adapters.melhor_envio.MelhorEnvioAdapter
ADDRESS_LOOKUP_ADAPTER=integrations.adapters.viacep.ViaCepAdapter
MEDIA_STORAGE_ADAPTER=integrations.adapters.media_local.LocalMediaAdapter
EMAIL_ADAPTER=integrations.adapters.email_console.ConsoleEmailAdapter

# --- Runware: integrations.adapters.runware.RunwareImageGenerationAdapter e RunwareModel3DAdapter ---
RUNWARE_API_KEY=
RUNWARE_IMAGE_MODEL=openai:gpt-image@2
RUNWARE_3D_MODEL=microsoft:trellis-2@4b
# Qualidade do Trellis: low | medium | high
TRELLIS_PRESET=low

# --- AbacatePay: integrations.adapters.abacatepay.AbacatePayAdapter ---
ABACATE_PAY_BASE_URL=https://api.abacatepay.com/v2
ABACATE_PAY_API_KEY=
ABACATE_PAY_WEBHOOK_SECRET=

# --- Melhor Envio: integrations.adapters.melhor_envio.MelhorEnvioAdapter ---
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
# Tokens iniciais obtidos ao autorizar o aplicativo. Depois são renovados pelo agendador.
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_REFRESH_TOKEN=
# Exigido pela API: nome da aplicação e e-mail técnico.
MELHOR_ENVIO_USER_AGENT=Kubo (contato@exemplo.com)
# Serviços oferecidos ao cliente (ids separados por vírgula; vazio = todos).
MELHOR_ENVIO_SERVICES=

# --- ViaCEP: integrations.adapters.viacep.ViaCepAdapter (sem chave) ---

# --- S3: integrations.adapters.media_s3.S3MediaAdapter ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_STORAGE_BUCKET_NAME=

# --- E-mail: integrations.adapters.email_smtp.SmtpEmailAdapter ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kubo <nao-responda@exemplo.com>
