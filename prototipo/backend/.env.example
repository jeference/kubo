# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Geração (ports/adapters) ---
# Real: integrations.adapters.runware.RunwareGenerationAdapter
# Offline (sem gastar créditos): integrations.adapters.runware_stub.StubGenerationAdapter
GENERATION_ADAPTER=integrations.adapters.runware.RunwareGenerationAdapter

# --- Runware ---
RUNWARE_API_KEY=
RUNWARE_IMAGE_MODEL=runware:100@1
RUNWARE_3D_MODEL=microsoft:trellis-2@4b
TRELLIS_SETTINGS={"resolution": 1024, "decimationTarget": 200000, "textureSize": 2048}
