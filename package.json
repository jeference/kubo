{
  "name": "kubo",
  "version": "0.1.0",
  "private": true,
  "description": "Kubo: crie um modelo com IA e receba a peça impressa em 3D.",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @kubo/consumer dev",
    "build": "pnpm --filter @kubo/consumer build",
    "start": "pnpm --filter @kubo/consumer start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx,css}\""
  },
  "devDependencies": { "prettier": "^3.4.2" }
}
